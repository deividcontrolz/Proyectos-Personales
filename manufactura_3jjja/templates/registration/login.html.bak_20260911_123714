{% load static %}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesion - 3-JJJ-A</title>
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="{% static 'css/3jjja-icons-mask.css' %}">
    <link rel="stylesheet" href="{% static 'css/login.css' %}">
</head>
<body>
    <div class="page-wrapper">
        <!-- Panel Izquierdo: Login -->
        <div class="left-panel">
            <div class="login-card">
                <div class="login-header">
                    <div class="login-logo">
                        <i class="bi bi-building-gear"></i>
                    </div>
                    <h1>Iniciar Sesion</h1>
                    <p>Sistema de Gestion de Produccion</p>
                </div>

                {% if messages %}
                <div class="messages-container">
                    {% for message in messages %}
                    <div class="alert alert-{{ message.tags }} fade-in">
                        <i class="bi bi-{% if message.tags == 'success' %}check-circle{% elif message.tags == 'error' %}x-circle{% else %}info-circle{% endif %}"></i>
                        {{ message }}
                    </div>
                    {% endfor %}
                </div>
                {% endif %}

                <form method="post" novalidate>
                    {% csrf_token %}
                    <div class="form-group">
                        <label for="username">Usuario</label>
                        <input type="text" id="id_username" name="username" class="form-control-dark"
                               placeholder="Ingrese su usuario" required autofocus autocomplete="username" maxlength="50">
                    </div>
                    <div class="form-group">
                        <label for="password">Contrasena</label>
                        <div class="password-input-wrapper">
                            <input type="password" id="id_password" name="password" class="form-control-dark"
                                   placeholder="Ingrese su contrasena" required autocomplete="current-password" maxlength="20">
                            <button type="button" class="toggle-password-btn" aria-label="Mostrar u ocultar contraseña">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>
                    <button type="submit" class="btn-login">
                        Iniciar Sesion
                    </button>
                </form>
            </div>
        </div>

        <!-- Panel Derecho: Branding + Features -->
        <div class="right-panel">
            <!-- Zona superior: titulos -->
            <div class="brand-zone">
                <i class="bi bi-building-gear brand-icon-top"></i>
                <h1 class="brand-title">Manufacturas 3-JJJ-A</h1>
                <div class="brand-line"></div>
                <h2 class="brand-subtitle">Sistema para la Linea de Produccion</h2>
            </div>

            <!-- Zona inferior: 4 cards de funcionalidades -->
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon green">
                        <i class="bi bi-layers"></i>
                    </div>
                    <h3>Gestion de Etapas</h3>
                    <p>Registra el flujo de produccion por etapas: entrada, proceso y salida de lotes en tiempo real.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon blue">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h3>Control de Calidad</h3>
                    <p>Audita pares aprobados y rechazados, asegurando estandares en cada lote manufacturado.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon orange">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <h3>Incidentes y Alertas</h3>
                    <p>Reporta, rastrea y resuelve incidentes operativos para minimizar tiempos muertos.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon purple">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                    <h3>Dashboard Gerencial</h3>
                    <p>Visualiza OEE, eficiencia por area, consumo energetico y reportes PDF de toda la planta.</p>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer-bar">
            <i class="bi bi-c-circle"></i> Copyright - <span>Manufacturas 3-JJJ-A</span> | Todos los derechos reservados
        </div>
    </div>

    <script src="{% static 'js/app.js' %}"></script>
    <script src="{% static 'js/login.js' %}"></script>
</body>
</html>